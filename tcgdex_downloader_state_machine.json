{
  "Comment": "Run TCGdex downloader in 30-page Lambda batches until the API is exhausted.",
  "StartAt": "Run batch",
  "States": {
    "Run batch": {
      "Type": "Task",
      "Resource": "${TCGDEX_LAMBDA_ARN}",
      "Parameters": {
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Finished?"
    },
    "Finished?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.statusCode",
          "NumericEquals": 200,
          "Next": "Read result"
        }
      ],
      "Default": "Failed"
    },
    "Read result": {
      "Type": "Pass",
      "Parameters": {
        "result.$": "States.StringToJson($.body)"
      },
      "ResultPath": "$.parsed",
      "Next": "Finished download?"
    },
    "Finished download?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.parsed.result.status",
          "StringEquals": "complete",
          "Next": "Done"
        }
      ],
      "Default": "Prepare next batch"
    },
    "Prepare next batch": {
      "Type": "Pass",
      "Parameters": {
        "start_page.$": "$.parsed.result.next_page",
        "max_pages": 30
      },
      "Next": "Run batch"
    },
    "Done": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "TcgdexLambdaFailed",
      "Cause": "The TCGdex Lambda did not return HTTP status 200."
    }
  }
}
